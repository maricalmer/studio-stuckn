# Copy to .env.local. Needed when calling the Sanity adapter; local routes do not
# require these values during step 6A.
NEXT_PUBLIC_SANITY_PROJECT_ID=35ex4ltc
NEXT_PUBLIC_SANITY_DATASET=production
# Use http://localhost:3333 locally and the separately deployed Studio URL in production.
# The deployed Studio origin is also the only production iframe parent allowed by CSP.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server-only. Use a restricted Viewer token; never prefix secrets NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
